modules = ["nodejs-20", "web", "postgresql-16", "python-3.11"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["cacert", "chromium", "freetype", "gcc", "gitFull", "glibc", "imagemagick", "lcms2", "libimagequant", "libjpeg", "librsvg", "libstdcxx5", "libtiff", "libwebp", "libxcrypt", "openjpeg", "playwright", "playwright-driver", "pyright", "python311", "python311Packages.beautifulsoup4", "python311Packages.httpx", "python311Packages.requests", "tcl", "tk", "zlib", "nspr", "nss", "at-spi2-atk", "cups", "libdrm", "libxkbcommon", "mesa", "pango", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXrandr", "xorg.libXcursor", "xorg.libXi", "xorg.libXtst", "xorg.libX11", "xorg.libXext", "xorg.libXfixes", "xorg.libxcb", "alsa-lib", "expat", "glib", "dbus", "gtk3"]

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000

[[ports]]
localPort = 5002
externalPort = 3001

[env]
PORT = "5000"

[deployment]
deploymentTarget = "autoscale"
build = ["npm", "run", "build"]
publicDir = "dist/public"
run = ["node", "./dist/index.cjs"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev"
waitForPort = 5000

[agent]
mockupState = "FULLSTACK"
